# Salin file ini menjadi .env lalu isi nilainya:  cp .env.example .env

# Kata sandi untuk masuk ke aplikasi. WAJIB diisi bila bisa diakses dari luar rumah.
APP_PASSWORD=ganti-dengan-kata-sandi-kuat

# API key dari https://console.anthropic.com (Settings → API Keys).
# Kosongkan bila belum punya: aplikasi tetap jalan dengan parser offline.
ANTHROPIC_API_KEY=

# Model AI. Default Claude Opus 5.5 (paling pintar).
# Lebih hemat: claude-sonnet-5-5  ·  paling murah & cepat: claude-haiku-5-5
AI_MODEL=claude-opus-5-5

# Tingkat "berpikir" AI: low | medium | high
# AI_EFFORT untuk catat cepat & tanya jawab; AI_VISION_EFFORT untuk baca
# screenshot, impor mutasi, dan susun budget.
AI_EFFORT=low
AI_VISION_EFFORT=medium

# Zona waktu (menentukan "hari ini" dan periode keuangan)
TZ=Asia/Jakarta

# Port di komputer Anda
PORT=7428

# Opsional: token Cloudflare Tunnel (lihat README bagian akses dari luar rumah)
CLOUDFLARE_TUNNEL_TOKEN=
